# Copie para .env. Valores são literais: não há expansão de shell neste arquivo.
# Campos vazios usam valores derivados ou são solicitados durante a instalação.
PROJECT_NAME=RupturSetup
BRAND_NAME=Ruptur
BASE_URL=https://ruptur.cloud
SUPPORT_EMAIL=contato@ruptur.cloud
SERVER_NAME=
DOCKER_NETWORK=ruptur-net
MONITOR_DIR=/opt/monitor-ruptur
# Pode receber o prefixo já usado por uma instalação existente da Evolution v1.
EVOLUTION_V1_PREFIX=evolution_rupturcloud
CHAT_BRAND_NAME=Ruptur-Chat
CHAT_DOMAIN=
SMTP_FROM_EMAIL=ruptur.cloud@gmail.com
# Vazio: usa SMTP_FROM_EMAIL, inclusive quando o parceiro informa outro remetente.
SMTP_USERNAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_PASSWORD=
SMTP_DOMAIN=
SMTP_AUTHENTICATION=login
SMTP_STARTTLS=true
CHATWOOT_IMAGE=chatwoot/chatwoot:latest
CHATWOOT_MEGA_IMAGE=sendingtk/chatwoot:latest
# Compatibilidade solicitada. O suporte efetivo depende da imagem escolhida.
CW_ENABLE_ENTERPRISE=true
ENTERPRISE_TOKEN=true
CHATWOOT_HUB_URL=
GITHUB_ORG=rupturcloud
GITHUB_REPO=ruptur-setup
GITHUB_REF=main
# Opcional: espelho HTTPS para recursos do repositório.
ASSET_BASE_URL=
# Integração opcional: informe uma origem compatível dos workflows Quepasa.
QUEPASA_WORKFLOWS_URL=
TELEMETRY_ENABLED=false
TELEMETRY_URL=
PUBLIC_IP_URL=https://api.ipify.org
COMMUNITY_URL=
VIDEO_URL=
DONATION_KEY=
FORMBRICKS_LICENSE_URL=
SUPABASE_MCP_PATH=ruptur-setup
