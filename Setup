#!/usr/bin/env bash
# Bootstrap: checkout local ou pacote completo da revisão indicada.
set -euo pipefail
setup_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -f "$setup_dir/RupturSetup" && -f "$setup_dir/lib/config.sh" ]]; then
    exec bash "$setup_dir/RupturSetup" "$@"
fi
setup_org=${GITHUB_ORG:-rupturcloud}
setup_repo=${GITHUB_REPO:-ruptur-setup}
setup_ref=${GITHUB_REF:-main}
setup_args=("$@")
while (($#)); do
    case "$1" in
        --org|--repo|--ref)
            (($# >= 2)) || { printf 'Falta valor para %s\n' "$1" >&2; exit 1; }
            case "$1" in --org) setup_org=$2 ;; --repo) setup_repo=$2 ;; --ref) setup_ref=$2 ;; esac
            shift ;;
        --help|-h)
            printf '%s\n' 'RupturSetup: bash Setup [--org ORG --repo REPO --ref REF] [opções do instalador]'
            printf '%s\n' 'Use um checkout local para --check-config e --render-chatwoot sem downloads.'
            exit 0 ;;
    esac
    shift
 done
[[ "$setup_org" =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ && "$setup_repo" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || exit 1
[[ "$setup_ref" =~ ^[a-zA-Z0-9][a-zA-Z0-9_./-]*$ && "$setup_ref" != *..* ]] || exit 1
command -v curl >/dev/null && command -v tar >/dev/null || { printf '%s\n' 'Instale curl e tar antes de executar o bootstrap.' >&2; exit 1; }
setup_tmp=$(mktemp -d)
trap 'rm -rf -- "$setup_tmp"' EXIT
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    --connect-timeout 15 --max-time 180 \
    "https://codeload.github.com/$setup_org/$setup_repo/tar.gz/$setup_ref" -o "$setup_tmp/source.tar.gz"
mkdir "$setup_tmp/source"
tar -xzf "$setup_tmp/source.tar.gz" --strip-components=1 -C "$setup_tmp/source"
[[ -f "$setup_tmp/source/RupturSetup" && -f "$setup_tmp/source/lib/config.sh" ]] || { printf '%s\n' 'Pacote incompleto: instalador ou módulos ausentes.' >&2; exit 1; }
GITHUB_ORG=$setup_org GITHUB_REPO=$setup_repo GITHUB_REF=$setup_ref \
    bash "$setup_tmp/source/RupturSetup" "${setup_args[@]}"
