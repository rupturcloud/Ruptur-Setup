volumes:
  chatwoot_nestor@@INSTANCE_SUFFIX@@_storage:
    external: true
    name: 'chatwoot_nestor@@INSTANCE_SUFFIX@@_storage'
  chatwoot_nestor@@INSTANCE_SUFFIX@@_public:
    external: true
    name: 'chatwoot_nestor@@INSTANCE_SUFFIX@@_public'
  chatwoot_nestor@@INSTANCE_SUFFIX@@_mailer:
    external: true
    name: 'chatwoot_nestor@@INSTANCE_SUFFIX@@_mailer'
  chatwoot_nestor@@INSTANCE_SUFFIX@@_mailers:
    external: true
    name: 'chatwoot_nestor@@INSTANCE_SUFFIX@@_mailers'

networks:
  @@nome_rede_interna@@:
    external: true
    name: '@@nome_rede_interna@@'
