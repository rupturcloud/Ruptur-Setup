version: "3.7"
services:

## --------------------------- RUPTUR --------------------------- ##

  chatwoot_nestor@@INSTANCE_SUFFIX@@_app:
    image: '@@CHATWOOT_MEGA_IMAGE@@'
    command: bundle exec rails s -p 3000 -b 0.0.0.0
    entrypoint: docker/entrypoints/rails.sh

    volumes:
      - 'chatwoot_nestor@@INSTANCE_SUFFIX@@_storage:/app/storage'
      - 'chatwoot_nestor@@INSTANCE_SUFFIX@@_public:/app/public'
      - 'chatwoot_nestor@@INSTANCE_SUFFIX@@_mailer:/app/app/views/devise/mailer'
      - 'chatwoot_nestor@@INSTANCE_SUFFIX@@_mailers:/app/app/views/mailers'

    networks:
      - '@@nome_rede_interna@@'

    environment:
      ## Qualquer Url com # no final
      CHATWOOT_HUB_URL: '@@CHATWOOT_HUB_URL@@'

      ## Nome da Empresa
      INSTALLATION_NAME: '@@nome_empresa_chatwoot@@'
      BRAND_NAME: '@@nome_empresa_chatwoot@@'
      BRAND_URL: '@@BASE_URL@@'
      MAILER_SUPPORT_EMAIL: '@@SUPPORT_EMAIL@@'
      CW_ENABLE_ENTERPRISE: '@@CW_ENABLE_ENTERPRISE@@'
      ENTERPRISE_TOKEN: '@@ENTERPRISE_TOKEN@@'

      ## Secret key
      SECRET_KEY_BASE: '@@encryption_key@@'

      ## Url Chatwoot
      FRONTEND_URL: 'https://@@url_chatwoot@@'
      FORCE_SSL: 'true'

      ## Idioma/Localização padrão
      DEFAULT_LOCALE: 'pt_BR'
      TZ: 'America/Brasil'

      ## Google Cloud - Modifique de acordo com os seus dados (lembre-se de mudar no chatwoot_sidekiq)
      #- GOOGLE_OAUTH_CLIENT_ID=369777777777-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
      #- GOOGLE_OAUTH_CLIENT_SECRET=ABCDEF-GHijklmnoPqrstuvwX-yz1234567
      #- GOOGLE_OAUTH_CALLBACK_URL=https://<your-server-domain>/omniauth/google_oauth2/callback

      ## Dados do Redis
      REDIS_URL: 'redis://redis:6379'
      REDIS_PREFIX: 'chatwoot_nestor@@INSTANCE_SUFFIX@@_'

      ## Dados do Postgres
      POSTGRES_HOST: 'pgvector'
      POSTGRES_USERNAME: 'postgres'
      POSTGRES_PASSWORD: '@@senha_pgvector@@'
      POSTGRES_DATABASE: 'chatwoot_nestor@@INSTANCE_SUFFIX@@'

      ## Armazenamento
      ACTIVE_STORAGE_SERVICE: 'local'
      #- STORAGE_BUCKET_NAME=chatwoot_nestor@@INSTANCE_SUFFIX@@
      #- STORAGE_ACCESS_KEY_ID=ACCESS_KEY_MINIO
      #- STORAGE_SECRET_ACCESS_KEY=SECRET_KEY_MINIO
      #- STORAGE_REGION=eu-south
      #- STORAGE_ENDPOINT=https://s3.DOMINIO.COM
      #- STORAGE_FORCE_PATH_STYLE=true

      ## Dados do SMTP
      MAILER_SENDER_EMAIL: '@@email_admin_chatwoot@@ <@@email_admin_chatwoot@@>'
      SMTP_DOMAIN: '@@dominio_smtp_chatwoot@@'
      SMTP_ADDRESS: '@@smtp_email_chatwoot@@'
      SMTP_PORT: '@@porta_smtp_chatwoot@@'
      SMTP_SSL: '@@sobre_ssl@@'
      SMTP_USERNAME: '@@user_smtp_chatwoot@@'
      SMTP_PASSWORD: '@@senha_email_chatwoot@@'
      SMTP_AUTHENTICATION: '@@SMTP_AUTHENTICATION@@'
      SMTP_ENABLE_STARTTLS_AUTO: '@@chat_starttls@@'
      SMTP_OPENSSL_VERIFY_MODE: 'peer'
      MAILER_INBOUND_EMAIL_DOMAIN: '@@email_admin_chatwoot@@'

      ## Melhorias
      SIDEKIQ_CONCURRENCY: '10'
      RACK_TIMEOUT_SERVICE_TIMEOUT: '0'
      RAILS_MAX_THREADS: '5'
      WEB_CONCURRENCY: '2'
      ENABLE_RACK_ATTACK: 'false'

      ## Outras configurações
      NODE_ENV: 'production'
      RAILS_ENV: 'production'
      INSTALLATION_ENV: 'docker'
      RAILS_LOG_TO_STDOUT: 'true'
      USE_INBOX_AVATAR_FOR_BOT: 'true'
      ENABLE_ACCOUNT_SIGNUP: 'false'

    deploy:
      mode: replicated
      replicas: 1
      placement:
        constraints:
          - node.role == manager
      resources:
        limits:
          cpus: "1"
          memory: 1024M
      labels:
        - traefik.enable=true
        - 'traefik.http.routers.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.rule=Host(`@@url_chatwoot@@`)'
        - 'traefik.http.routers.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.entrypoints=websecure'
        - 'traefik.http.routers.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.tls.certresolver=letsencryptresolver'
        - 'traefik.http.routers.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.priority=1'
        - 'traefik.http.routers.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.service=chatwoot_nestor@@INSTANCE_SUFFIX@@_app'
        - 'traefik.http.services.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.loadbalancer.server.port=3000 '
        - 'traefik.http.services.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.loadbalancer.passHostHeader=true '
        - traefik.http.middlewares.sslheader.headers.customrequestheaders.X-Forwarded-Proto=https
        - 'traefik.http.routers.chatwoot_nestor@@INSTANCE_SUFFIX@@_app.middlewares=sslheader'

## --------------------------- RUPTUR --------------------------- ##

