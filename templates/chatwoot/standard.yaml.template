    ## 🧑‍💻 Dados do Redis
      REDIS_URL: 'redis://chatwoot@@INSTANCE_SUFFIX@@_redis:6379'

    ## 🗄️ Dados do Postgres
      POSTGRES_HOST: 'pgvector'
      POSTGRES_USERNAME: 'postgres'
