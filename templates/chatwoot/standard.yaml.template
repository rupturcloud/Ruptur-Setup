## --------------------------- RUPTUR --------------------------- ##

  chatwoot@@INSTANCE_SUFFIX@@_redis:
    image: redis:latest  ## Versão do Redis
    command: [
        "redis-server",
        "--appendonly",
        "yes",
        "--port",
        "6379"
      ]

    volumes:
      - 'chatwoot@@INSTANCE_SUFFIX@@_redis:/data'

    networks:
      - '@@nome_rede_interna@@'

    ## Descomente as linhas abaixo para uso externo
    #ports:
    #  - 6379:6379

    deploy:
      placement:
        constraints:
          - node.role == manager
      resources:
        limits:
          cpus: "1"
          memory: 1024M

## --------------------------- RUPTUR --------------------------- ##

volumes:
  chatwoot@@INSTANCE_SUFFIX@@_storage:
    external: true
    name: 'chatwoot@@INSTANCE_SUFFIX@@_storage'
  chatwoot@@INSTANCE_SUFFIX@@_public:
    external: true
    name: 'chatwoot@@INSTANCE_SUFFIX@@_public'
  chatwoot@@INSTANCE_SUFFIX@@_mailer:
    external: true
    name: 'chatwoot@@INSTANCE_SUFFIX@@_mailer'
  chatwoot@@INSTANCE_SUFFIX@@_mailers:
    external: true
    name: 'chatwoot@@INSTANCE_SUFFIX@@_mailers'
  chatwoot@@INSTANCE_SUFFIX@@_redis:
    external: true
    name: 'chatwoot@@INSTANCE_SUFFIX@@_redis'

networks:
  @@nome_rede_interna@@:
    external: true
    name: '@@nome_rede_interna@@'
